        "explain how", "tell me how", "show me how",
        "what to do", "what to bring", "what to prepare",
        "is it safe", "is it possible",
        "difference between", "how does"
    ) else listOf(
        // Kata tanya + cara
        "bagaimana cara", "gimana cara", "cara membuat", "cara bikin",
